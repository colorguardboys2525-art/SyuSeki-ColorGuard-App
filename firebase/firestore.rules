rules_version = '2';

// 出席表アプリ Firestoreセキュリティルール
//  - 管理者 : admins/{メールアドレス} にドキュメントがある Googleアカウント（事前登録制）
//  - 一般   : 匿名ログイン済み。出席表とフィルターの「読み取りのみ」
//  - メモは管理者だけ（読み書き）。メモは m0〜m9 の10枠まで。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Googleログイン済み・メール確認済み・admins に登録済み
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // 管理者名簿：本人が自分の登録有無を確認するための読み取りだけ許可。書き込みはコンソール/管理スクリプトのみ。
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, write: if false;
    }

    // 出席表（メタ情報と行データ）
    match /attendance/{batchId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /rows/{rowId} {
        allow read: if signedIn();
        allow create, update: if isAdmin()
          && request.resource.data.current is string && request.resource.data.current.size() == 15
          && request.resource.data.name is string && request.resource.data.name.size() <= 100;
        allow delete: if isAdmin();
      }
    }

    // フィルター（メンバー名簿）
    match /filters/{filterId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.members is list && request.resource.data.members.size() <= 500;
      allow delete: if isAdmin();
    }

    // 変更連絡メモ（最大10枚 = m0〜m9）
    match /memos/{memoId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && memoId.matches('m[0-9]')
        && request.resource.data.text is string && request.resource.data.text.size() <= 5000;
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
